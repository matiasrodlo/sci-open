{
  // The build emits from `src` alone, so `scripts/` sits outside the program
  // `tsconfig.json` describes and would never be checked. This adds it back
  // without emitting, so the fixture recorder fails the typecheck rather than
  // rotting quietly.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["scripts/**/*", "src/**/*"]
}
