{
  "name": "@sci-open/core",
  "version": "1.0.0",
  "description": "The sci-open search engine: providers, authorities, orchestrator",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "testing.js", "testing.d.ts"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src scripts --ext .ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "record:fixtures": "tsx scripts/record-fixtures.ts"
  },
  "dependencies": {
    "@sci-open/shared": "workspace:*",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "node-html-parser": "^9.0.4",
    "unpdf": "^1.8.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.57.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": { "node": ">=22.12" }
}
