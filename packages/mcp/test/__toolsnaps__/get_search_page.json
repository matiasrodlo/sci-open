            "required": [
              "value",
              "count"
            ],
            "additionalProperties": false
          }
        }
      },
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "doi": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "authors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "year": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "venue": {
              "type": "string"
            },
            "access": {
              "type": "string",
              "enum": [
                "gold",
                "green",
                "hybrid",
                "bronze",
                "closed",
                "unknown"
              ]
            },
            "stage": {
              "type": "string",
              "enum": [
                "preprint",
                "accepted",
                "published",
                "unknown"
              ]
            },
            "full_text": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "pdf",
                    "html",
                    "xml"
                  ]
                },
                "verified": {
                  "type": "boolean"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "verified"
              ],
              "additionalProperties": false
            },
            "citations": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "found_in": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "abstract": {
              "type": "string"
            },
            "publisher": {
              "type": "string"
            },
            "topics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "language": {
              "type": "string"
            },
            "landing_page": {
              "type": "string"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "native_id": {
                    "type": "string"
                  },
                  "rank": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "retrieved_at": {
                    "type": "string"
                  }
                },
                "required": [
                  "source",
                  "native_id",
                  "rank",
                  "retrieved_at"
                ],
                "additionalProperties": false
              }
            },
            "field_sources": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
            "title",
            "authors",
            "access",
            "stage",
            "found_in"
          ],
          "additionalProperties": false
        }
      },
      "omitted_for_size": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "rerun": {
        "type": "boolean"
      }
    },
    "required": [
      "handle",
      "query",
      "total",
      "total_is_lower_bound",
      "page",
      "page_size",
      "has_more",
      "next",
      "coverage",
      "results"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false
  },
  "annotations": {
    "title": "Get search page",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  }
}
