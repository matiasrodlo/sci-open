# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
.turbo/

# Environment variables
# Every .env variant, not an enumerated few. A file named `.env.production` or
# `.env.backup-20260830` is as committable as `.env` was ignorable, and the
# enumeration below missed both.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

