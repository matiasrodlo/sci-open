# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.turbo/

# Environment variables
# Every .env variant, not an enumerated few. A file named `.env.production` or
# `.env.backup-20260830` is as committable as `.env` was ignorable, and the
# enumeration below missed both.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# The package published to npm, generated by packages/mcp/scripts/build-npm.ts
packages/mcp/npm/

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Temporary folders
tmp/
temp/

# Editor directories and files
.vscode/
.idea/
# .claude/ holds per-machine editor state, except launch.json: the dev-server
# configuration is the same for everyone and belongs in the repo.
.claude/*
!.claude/launch.json
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db


# Old/temporary files
*.old
*.backup
*.tmp
*~
