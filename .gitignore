.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Gatsby files
#
# The `public` entry that used to live here is gone. This is not a Gatsby
# project, and an unanchored `public` matches at every depth — so it ignored
# `apps/web/public/`, which is where Next serves static assets from.
# `apps/web/Dockerfile` already carries a note anticipating that directory
# being added, so the first favicon or OG image would have been untracked *and*
# missing from the image: two things to discover instead of none.
.cache/

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Editor directories and files
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

