{
  "name": "@open-access-explorer/api",
  "version": "1.0.0",
  "description": "Fastify API server for Open Access Explorer",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts --ext .ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@open-access-explorer/shared": "workspace:*",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.29.1",
    "ioredis": "^5.11.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
