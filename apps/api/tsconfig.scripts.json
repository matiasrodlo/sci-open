{
  // The build emits from `src` alone, so `scripts/` sits outside the program
  // `tsconfig.json` describes and would never be checked. This adds it back
  // without emitting: `compare-paths.ts` is the evidence phase 07 rests on,
  // and a harness that stops compiling in silence measures nothing.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["scripts/**/*", "src/**/*"]
}
