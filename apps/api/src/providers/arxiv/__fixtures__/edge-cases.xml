<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-built, unlike the recorded arxiv.xml. Each entry isolates a shape the
  recorded feed happens not to contain. Keep them minimal: they are here to pin
  behaviour, not to look realistic. The field values are modelled on real
  responses — `arxiv:doi` and `arxiv:journal_ref` were observed on 3 and 2 of
  16 live entries for `crispr gene editing`.
-->
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:arxiv="http://arxiv.org/schemas/atom" xmlns:opensearch="http://a9.com/-/spec/opensearch/1.1/">
  <opensearch:totalResults>5</opensearch:totalResults>

  <!-- Published elsewhere: carries the DOI and journal the old connector never read. -->
  <entry>
    <id>http://arxiv.org/abs/2101.00001v1</id>
    <title>A preprint that was later published</title>
    <summary>Body text.</summary>
    <published>2021-01-04T00:00:00Z</published>
    <author><name>Ada Lovelace</name></author>
    <link href="https://arxiv.org/abs/2101.00001v1" rel="alternate" type="text/html"/>
    <link href="https://arxiv.org/pdf/2101.00001v1" rel="related" type="application/pdf" title="pdf"/>
    <category term="q-bio.GN" scheme="http://arxiv.org/schemas/atom"/>
    <arxiv:doi>10.1038/s41467-022-30843-1</arxiv:doi>
    <arxiv:journal_ref>Phys. Rev. Lett. 127, 208102, 2021</arxiv:journal_ref>
  </entry>

  <!-- arXiv still advertises some links over http. -->
  <entry>
    <id>http://arxiv.org/abs/2101.00002v1</id>
    <title>A record whose pdf link is not https</title>
    <summary>Body text.</summary>
    <published>2021-02-04T00:00:00Z</published>
    <author><name>Grace Hopper</name></author>
    <link href="http://arxiv.org/pdf/2101.00002v1" rel="related" type="application/pdf" title="pdf"/>
  </entry>

  <!-- No pdf link at all: fullText must be absent rather than invented. -->
  <entry>
    <id>http://arxiv.org/abs/2101.00003v1</id>
    <title>A record with no pdf</title>
    <summary>Body text.</summary>
    <published>2021-03-04T00:00:00Z</published>
    <author><name>Alan Turing</name></author>
    <link href="https://arxiv.org/abs/2101.00003v1" rel="alternate" type="text/html"/>
  </entry>

  <!-- Atom keeps the source document's line wrapping. -->
  <entry>
    <id>http://arxiv.org/abs/2101.00004v1</id>
    <title>A title broken
      across   several
      lines</title>
    <summary>An abstract
      wrapped the same way.</summary>
    <published>2021-04-04T00:00:00Z</published>
    <author><name>Katherine Johnson</name></author>
  </entry>

  <!-- Unreadable: must cost exactly one record. -->
  <entry>
    <id>http://arxiv.org/abs/2101.00005v1</id>
    <summary>An entry with no title.</summary>
    <published>2021-05-04T00:00:00Z</published>
  </entry>
</feed>
