{
  "name": "sci-open",
  "version": "1.0.0",
  "description": "sci-open: an MCP server for open-access scientific literature, with the search engine it is built on",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "turbo": "^2.11.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@8.10.0",
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "glob": ">=10.5.0"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
