{
  "name": "open-access-explorer",
  "version": "1.0.0",
  "description": "WoS-style UI for open-access papers with multi-source search",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "turbo": "^1.13.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@8.10.0",
  "dependencies": {
    "axios": "^1.20.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "glob": ">=10.5.0"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
