# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:4000

# API
PORT=4000
NODE_ENV=development

# Log level: trace, debug, info, warn, error, fatal.
# Defaults to info when NODE_ENV=production, debug otherwise.
LOG_LEVEL=

# Which implementation serves POST /api/search: pipeline or orchestrator.
# Anything else, including unset, falls back to pipeline rather than failing to
# start. Read once at boot, so changing it takes a restart — that empties the
# in-memory response cache, so a body written by one path is never served by
# the other. Every reply carries X-Search-Path saying which one answered.
SEARCH_PATH=

# Cache Configuration
REDIS_URL=redis://localhost:6379
CACHE_L1_TTL=300
CACHE_L2_TTL=3600
CACHE_L3_TTL=86400

# Sources
# API keys are optional and must be left EMPTY when you do not have one.
#
# A placeholder is not a neutral default — it is a wrong credential, and a wrong
# credential is worse than none. Measured: DataCite answers
# `Authorization: Bearer your_datacite_api_key_here` with HTTP 401, where the
# same request carrying no header at all answers 200. CORE behaves the same way,
# and CORE needs no key for access at all — only for a larger rate limit than
# the anonymous 10 requests per five minutes.
CORE_API_KEY=
ARXIV_BASE=https://export.arxiv.org/api/query
EUROPE_PMC_BASE=https://www.ebi.ac.uk/europepmc/webservices/rest
NCBI_EUTILS_BASE=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
NCBI_API_KEY=
BIORXIV_BASE=https://api.biorxiv.org
OPENAIRE_BASE=https://api.openaire.eu/search
PLOS_BASE=https://api.plos.org/search
DOAJ_BASE=https://doaj.org/api
DOAJ_API_KEY=

# Enrichment Services
UNPAYWALL_EMAIL=your-email@example.com

# Aggregators
OPENCITATIONS_BASE=https://opencitations.net/index/coci/api/v1
OPENCITATIONS_API_KEY=
DATACITE_BASE=https://api.datacite.org/dois
DATACITE_API_KEY=

# HTTP Connection Pooling Configuration
# Global pool settings
HTTP_POOL_MAX_CONNECTIONS=20
HTTP_POOL_KEEP_ALIVE_TIMEOUT=30000
HTTP_POOL_MAX_SOCKETS=50
HTTP_POOL_TIMEOUT=10000
HTTP_POOL_RETRY_ATTEMPTS=3
HTTP_POOL_RETRY_DELAY=1000
HTTP_POOL_ENABLE_HTTP2=true

# Service-specific pool configurations (JSON format)
# Example: {"maxConnections": 30, "maxSockets": 100, "keepAliveTimeout": 60000}
OPENALEX_POOL_CONFIG={"maxConnections": 30, "maxSockets": 100, "keepAliveTimeout": 60000}
CROSSREF_POOL_CONFIG={"maxConnections": 25, "maxSockets": 80, "keepAliveTimeout": 45000}
UNPAYWALL_POOL_CONFIG={"maxConnections": 40, "maxSockets": 120, "keepAliveTimeout": 90000}
CORE_POOL_CONFIG={"maxConnections": 20, "maxSockets": 60, "keepAliveTimeout": 30000}
DATACITE_POOL_CONFIG={"maxConnections": 15, "maxSockets": 40, "keepAliveTimeout": 25000}
NCBI_POOL_CONFIG={"maxConnections": 25, "maxSockets": 70, "keepAliveTimeout": 40000}
EUROPE_PMC_POOL_CONFIG={"maxConnections": 20, "maxSockets": 50, "keepAliveTimeout": 35000}

# Administrative endpoints
# Gates /api/cache/*, /api/performance/* and /debug/*.
# Send it as `Authorization: Bearer <key>`. Leave unset and those routes are
# disabled entirely; the public search, paper and download routes are unaffected.
ADMIN_API_KEY=
