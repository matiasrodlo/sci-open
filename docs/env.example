# Frontend
# Where the Next server sends /api/* on the server side. Read per request in
# `apps/web/app/api/[...path]/route.ts` and in `lib/fetcher.ts`, so it is a
# deployment setting rather than a build-time one — changing it does not need a
# rebuild. This replaced NEXT_PUBLIC_API_BASE, which was inlined at build time.
API_ORIGIN=http://localhost:4000

# API
PORT=4000
NODE_ENV=development

# Log level: trace, debug, info, warn, error, fatal.
# Defaults to info when NODE_ENV=production, debug otherwise.
LOG_LEVEL=

# Rate limiting, applied per IP across every route.
# Defaults are 120 requests per '1 minute'. The window accepts any string
# @fastify/rate-limit parses, e.g. '30 seconds' or '1 hour'.
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW=

# Cache Configuration
REDIS_URL=redis://localhost:6379

# The L1 budget, in bytes. 256 MB by default. Bounded in bytes rather than in
# entries because the things counted are pages of search results.
CACHE_MAX_BYTES=

# Sources
# API keys are optional and must be left EMPTY when you do not have one.
#
# A placeholder is not a neutral default — it is a wrong credential, and a wrong
# credential is worse than none. Measured: DataCite answers
# `Authorization: Bearer your_datacite_api_key_here` with HTTP 401, where the
# same request carrying no header at all answers 200. CORE behaves the same way,
# and CORE needs no key for access at all — only for a larger rate limit than
# the anonymous 10 requests per five minutes.
#
# There are no *_BASE variables here any more. Every provider and authority now
# takes its base URL as a `baseUrl` option defaulting to a module constant, and
# reads no environment at all — the nine that used to be listed (ARXIV_BASE,
# EUROPE_PMC_BASE, NCBI_EUTILS_BASE, BIORXIV_BASE, OPENAIRE_BASE, PLOS_BASE,
# DOAJ_BASE, DATACITE_BASE, OPENCITATIONS_BASE) had been inert since the
# providers were rewritten. The option exists so a test can point a fetch at a
# fixture server; it is not a deployment knob. OPENCITATIONS_API_KEY is gone for
# the same reason: that authority sends no auth header.
CORE_API_KEY=
NCBI_API_KEY=
DOAJ_API_KEY=
DATACITE_API_KEY=

# Enrichment Services
UNPAYWALL_EMAIL=your-email@example.com

# HTTP Connection Pooling Configuration
# Global pool settings
HTTP_POOL_MAX_CONNECTIONS=20
HTTP_POOL_KEEP_ALIVE_TIMEOUT=30000
HTTP_POOL_MAX_SOCKETS=50
HTTP_POOL_TIMEOUT=10000
HTTP_POOL_RETRY_ATTEMPTS=3
HTTP_POOL_RETRY_DELAY=1000
HTTP_POOL_ENABLE_HTTP2=true

# Service-specific pool configurations (JSON format)
# Merged over the global settings above for that one service.
# Example: {"maxConnections": 30, "maxSockets": 100, "keepAliveTimeout": 60000}
#
# Only these five exist because only these five providers fetch through the
# pooled client. CORE and Europe PMC call axios directly, so the
# CORE_POOL_CONFIG and EUROPE_PMC_POOL_CONFIG that used to be listed were
# parsed at startup into a map nothing ever queried.
OPENALEX_POOL_CONFIG={"maxConnections": 30, "maxSockets": 100, "keepAliveTimeout": 60000}
CROSSREF_POOL_CONFIG={"maxConnections": 25, "maxSockets": 80, "keepAliveTimeout": 45000}
UNPAYWALL_POOL_CONFIG={"maxConnections": 40, "maxSockets": 120, "keepAliveTimeout": 90000}
DATACITE_POOL_CONFIG={"maxConnections": 15, "maxSockets": 40, "keepAliveTimeout": 25000}
NCBI_POOL_CONFIG={"maxConnections": 25, "maxSockets": 70, "keepAliveTimeout": 40000}

# Administrative endpoints
# Gates /api/cache/* and /api/performance/*.
# Send it as `Authorization: Bearer <key>`. Leave unset and those routes are
# disabled entirely; the public search, paper and download routes are unaffected.
ADMIN_API_KEY=
