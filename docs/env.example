# Frontend
# Where the Next server sends /api/* on the server side. Read per request in
# `apps/web/app/api/[...path]/route.ts` and in `lib/fetcher.ts`, so it is a
# deployment setting rather than a build-time one — changing it does not need a
# rebuild. This replaced NEXT_PUBLIC_API_BASE, which was inlined at build time.
API_ORIGIN=http://localhost:4000

# API
PORT=4000
NODE_ENV=development

# Log level: trace, debug, info, warn, error, fatal.
# Defaults to info when NODE_ENV=production, debug otherwise.
LOG_LEVEL=

# Rate limiting, applied per IP across every route.
# Defaults are 120 requests per '1 minute'. The window accepts any string
# @fastify/rate-limit parses, e.g. '30 seconds' or '1 hour'.
# "Per IP" means per connecting address unless TRUST_PROXY says otherwise —
# see below, because behind the web tier that is one address for everybody.
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW=

# Which hops in front of this service may state the caller's address in
# X-Forwarded-For. Unset trusts none of them, so request.ip — and with it the
# rate-limit key — is whoever opened the socket.
#
# That default is wrong for any real deployment and right as a default. The
# browser never calls this service directly: apps/web proxies /api/* to it, so
# every request arrives from the web tier and RATE_LIMIT_MAX becomes one bucket
# shared by every visitor. Setting this makes it per caller again. Setting it to
# an address that is not actually a proxy is the opposite mistake and worse —
# X-Forwarded-For is a request header, so any caller could then pick their own
# key and the limit would apply to no one.
#
# Accepts: true, false, a single address, a CIDR, a comma-separated list of
# either, or one of loopback / linklocal / uniquelocal. Name the proxy, not the
# world: 'true' is only safe when nothing but the proxy can open a connection to
# this port.
#
# A bare number used to mean "trust this many hops" and no longer works.
# Fastify 5 answers a hop count by trusting no proxy at all — hop-count-only
# trust cannot check the immediate peer, so a direct client could spoof
# X-Forwarded-* by supplying enough hops. The service refuses the value and says
# so at startup rather than looking configured while the rate limit quietly goes
# back to one bucket for everyone.
TRUST_PROXY=

# Search
# How many papers the open-access/full-text gate may ask an authority about
# before dropping them. 200 by default; 0 disables the step.
# The cost is one request per candidate to each authority authoritative on a
# gated field, which today means Unpaywall alone. Candidates past the limit are
# dropped as they were before, and the search reports that it was bounded.
SEARCH_RESCUE_LIMIT=

# Cache Configuration
REDIS_URL=redis://localhost:6379

# The L1 budget, in bytes. 256 MB by default. Bounded in bytes rather than in
# entries because the things counted are pages of search results.
CACHE_MAX_BYTES=

# The fan-out cache's budget, in bytes. 128 MB by default. This is the separate,
# in-process cache of what each provider returned — what makes a page-2 click
# reuse the fan-out it was paged from instead of repeating it.
#
# Bounded in bytes for the same reason as CACHE_MAX_BYTES, and it had further to
# fall: it used to cap at 500 entries, and an entry holds up to `depth` records
# with a default depth of 600. That is 300,000 papers, about 518 MB serialised
# at the measured size, and one to one and a half gigabytes of live heap.
#
# Counted as serialised size, so expect two to three times this value resident.
# An entry larger than the whole budget is not cached at all rather than
# evicting everything else to fit, so setting this very low disables the cache
# rather than thrashing it.
PROVIDER_CACHE_MAX_BYTES=

# How long L2 stays shut after a Redis failure, in milliseconds. 5000 by
# default. One failure holds Redis closed for this long and the operations
# behind it go straight to memory, rather than each of them paying the
# connection timeout again; any success reopens it early. Deletes and
# invalidations ignore the cooldown, because skipping a read costs a miss
# while skipping a delete leaves behind an entry a caller asked to remove.
CACHE_REDIS_COOLDOWN_MS=

# Sources
# API keys are optional and must be left EMPTY when you do not have one.
#
# A placeholder is not a neutral default — it is a wrong credential, and a wrong
# credential is worse than none. Measured: DataCite answers
# `Authorization: Bearer your_datacite_api_key_here` with HTTP 401, where the
# same request carrying no header at all answers 200. CORE behaves the same way,
# and CORE needs no key for access at all — only for a larger rate limit than
# the anonymous 10 requests per five minutes.
#
# There are no *_BASE variables here any more. Every provider and authority now
# takes its base URL as a `baseUrl` option defaulting to a module constant, and
# reads no environment at all — the nine that used to be listed (ARXIV_BASE,
# EUROPE_PMC_BASE, NCBI_EUTILS_BASE, BIORXIV_BASE, OPENAIRE_BASE, PLOS_BASE,
# DOAJ_BASE, DATACITE_BASE, OPENCITATIONS_BASE) had been inert since the
# providers were rewritten. The option exists so a test can point a fetch at a
# fixture server; it is not a deployment knob. OPENCITATIONS_API_KEY is gone for
# the same reason: that authority sends no auth header.
CORE_API_KEY=
NCBI_API_KEY=
DOAJ_API_KEY=
DATACITE_API_KEY=

# Enrichment Services
UNPAYWALL_EMAIL=your-email@example.com

# HTTP Connection Pooling Configuration
# Global pool settings
HTTP_POOL_MAX_CONNECTIONS=20
HTTP_POOL_KEEP_ALIVE_TIMEOUT=30000
HTTP_POOL_MAX_SOCKETS=50
HTTP_POOL_TIMEOUT=10000
HTTP_POOL_RETRY_ATTEMPTS=3
HTTP_POOL_RETRY_DELAY=1000
HTTP_POOL_ENABLE_HTTP2=true

# Service-specific pool configurations (JSON format)
# Merged over the global settings above for that one service.
# Example: {"maxConnections": 30, "maxSockets": 100, "keepAliveTimeout": 60000}
#
# One per service, and every upstream is now on the pooled client. It used to be
# five of thirteen, and the eight missing were the search fan-out — so these
# knobs, and the /api/performance/* metrics, reached the cheapest callers and
# not the ones that decide how long a search takes. Values below are examples;
# unset means the global defaults above.
#
# The metadata and OA authorities, asked once per record on a page:
OPENALEX_POOL_CONFIG={"maxConnections": 30, "maxSockets": 100, "keepAliveTimeout": 60000}
CROSSREF_POOL_CONFIG={"maxConnections": 25, "maxSockets": 80, "keepAliveTimeout": 45000}
UNPAYWALL_POOL_CONFIG={"maxConnections": 40, "maxSockets": 120, "keepAliveTimeout": 90000}
OPENCITATIONS_POOL_CONFIG=
DATACITE_POOL_CONFIG={"maxConnections": 15, "maxSockets": 40, "keepAliveTimeout": 25000}
#
# The search fan-out, asked once per search each and read to `depth` records:
NCBI_POOL_CONFIG={"maxConnections": 25, "maxSockets": 70, "keepAliveTimeout": 40000}
EUROPEPMC_POOL_CONFIG=
ARXIV_POOL_CONFIG=
BIORXIV_POOL_CONFIG=
CORE_POOL_CONFIG=
DOAJ_POOL_CONFIG=
OPENAIRE_POOL_CONFIG=
PLOS_POOL_CONFIG=

# Administrative endpoints
# Gates /api/cache/* and /api/performance/*.
# Send it as `Authorization: Bearer <key>`. Leave unset and those routes are
# disabled entirely; the public search, paper and download routes are unaffected.
ADMIN_API_KEY=
